generator client {
  provider = "postgresql"
}

datasource db {
  provider = "postgresql"
}

// Core entities per CLAUDE.md §11

model User {
  id          String   @id @default(uuid())
  name        String?
  email       String   @unique
  password    String
  role        String   @default("RENTER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile     Profile?
  profileId   String?   @unique

  // Bookings where this user is the renter
  rentedBookings Booking[]   @relation(name: "UserRentedBookings")

  // Provider profile (one-to-one)
  providerProfile Provider?   @relation(name: "UserProvider")
}

model Profile {
  id        String   @id @default(uuid())
  bio       String?
  avatar    String?
  phone     String?

  userId    String   @unique

  // One profile belongs to one user
  user      User     @relation(fields: [userId], references: [id])

  // Profile belongs to a city (optional)
  cityId    String?

  city      City?    @relation(fields: [cityId], references: [id])
}

model City {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())

  profiles    Profile[]
  kits        Kit[]
}

model Kit {
  id          String   @id @default(uuid())
  name        String
  description String
  dailyPrice  Int       // stored in paise per CLAUDE.md §8
  category    String    // e.g., "Reels", "Vlog", "Portrait", "Podcast"
  images      String[]  // URLs to equipment images

  cityId      String

  // Kit belongs to a city
  city      City     @relation(fields: [cityId], references: [id])

  equipment   Equipment[]
  listings    Listing[]
}

model Equipment {
  id          String   @id @default(uuid())
  kitId       String?

  // Equipment belongs to a kit (optional)
  kit       Kit?     @relation(fields: [kitId], references: [id])
}

model Listing {
  id          String   @id @default(uuid())

  providerId  String

  kitId       String

  availability Boolean   @default(true)
  rentedFrom   DateTime?
  rentedUntil  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kit     Kit?       @relation(fields: [kitId], references: [id])
  provider    Provider   @relation(name: "ProviderListings", fields: [providerId], references: [id])
  bookings    Booking[]   @relation(name: "BookingListings")
}

model Booking {
  id          String   @id @default(uuid())

  renterId    String

  listingId   String

  status      String   @default("PENDING") // PENDING, CONFIRMED, ACTIVE, COMPLETED
  totalPrice  Int       // in paise per CLAUDE.md §8

  createdAt   DateTime @default(now())

  // Relations
  user      User       @relation(name: "UserRentedBookings", fields: [renterId], references: [id])
  listing   Listing    @relation(name: "BookingListings", fields: [listingId], references: [id])
  transactions Transaction[]   @relation(name: "BookingTransactions")
}

model Transaction {
  id          String   @id @default(uuid())

  bookingId   String

  providerId  String

  amount      Int       // in paise per CLAUDE.md §8
  status      String   // "PENDING", "PAID", "REFUNDED", "FAILED"
  paymentId   String?  // Razorpay payment link ID

  createdAt   DateTime @default(now())

  // Relations
  booking Booking   @relation(name: "BookingTransactions", fields: [bookingId], references: [id])
  Provider   Provider   @relation(name: "ProviderTransactions", fields: [providerId], references: [id])
}

model Provider {
  id          String   @id @default(uuid())
  userId      String   @unique
  businessName String
  phone       String
  address     String?
  cityId      String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User     @relation(name: "UserProvider", fields: [userId], references: [id])

  // Provider's listings
  listings    Listing[]   @relation(name: "ProviderListings")

  // Provider's transactions
  transactions Transaction[]   @relation(name: "ProviderTransactions")
}

model ProviderPayout {
  id          String   @id @default(uuid())

  providerId  String   // references Provider.id

  amount      Int      // in paise
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED

  razorpayId  String?  // Razorpay payout ID

  createdAt   DateTime @default(now())
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String   // associated with a user
  hash        String   // SHA-256 hash of the refresh token (never plaintext)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime? // null = active, set = revoked

  // One token per user per session; multiple active tokens allowed
  @@ unique([hash]) // hash is unique across all tokens
}